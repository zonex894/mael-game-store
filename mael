crop_specs = {

    "logo.jpg": (0, 320, 710, 1260),

    "payments.jpg": (0, 390, 710, 1110),

    "switch_oled.jpg": (0, 325, 710, 1280),

    "switch_lite.jpg": (0, 330, 710, 1210),

    "accessories.jpg": (0, 320, 710, 1280),

    "switch_2.jpg": (0, 350, 710, 1280),

}

for name, box in zip(crop_specs, crop_specs.values()):

    # Map crop names to source screenshots.

